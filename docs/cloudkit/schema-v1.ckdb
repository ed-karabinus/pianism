DEFINE SCHEMA

    RECORD TYPE CD_SessionRecord (
        CD_deletedAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_endedAt             TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_modifiedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_note                ENCRYPTED STRING,
        CD_note_ckAsset        ASSET,
        CD_pauses              BYTES QUERYABLE SORTABLE,
        CD_pauses_ckAsset      ASSET,
        CD_source              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_source_ckAsset      ASSET,
        CD_startedAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_tagIDs              BYTES QUERYABLE SORTABLE,
        CD_tagIDs_ckAsset      ASSET,
        CD_timeZoneID          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_timeZoneID_ckAsset  ASSET,
        CD_version             INT64 QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TagRecord (
        CD_composer            ENCRYPTED STRING,
        CD_composer_ckAsset    ASSET,
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id_ckAsset          ASSET,
        CD_isArchived          INT64 QUERYABLE SORTABLE,
        CD_kind                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kind_ckAsset        ASSET,
        CD_mergedInto          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_mergedInto_ckAsset  ASSET,
        CD_modifiedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                ENCRYPTED STRING,
        CD_name_ckAsset        ASSET,
        CD_targetTempo         INT64 QUERYABLE SORTABLE,
        CD_version             INT64 QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
