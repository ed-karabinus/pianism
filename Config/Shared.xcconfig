// Settings shared by every target and configuration.
// Build settings live in these files, not in project.pbxproj, so changes are reviewable.

SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 26.0
// 1 = iPhone, 2 = iPad. The iPad on a music stand is a primary use.
TARGETED_DEVICE_FAMILY = 1,2
// Here, not per target: App Store validation requires the app and its extension to agree on both.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES

CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
// As Xcode's templates set it: stripping the signed extension while embedding it only warns, and does nothing.
COPY_PHASE_STRIP = NO
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

CODE_SIGN_STYLE = Automatic

// Personal overrides such as DEVELOPMENT_TEAM go in Config/Local.xcconfig (git-ignored).
#include? "Local.xcconfig"
