<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CloudKit's silent pushes, so changes from the user's other devices arrive without a relaunch
	     (SYN-1). The only background mode Pianism has (NFR-9, as amended 2026-10-20). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Pianism uses only the system's encryption, such as HTTPS and iCloud's, so App Store Connect
	     asks no export questions on upload (NFR-9). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
